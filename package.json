{
  "name": "@leonardschwier/leoforma",
  "version": "0.1.1",
  "description": "Leoforma: design tokens and thin, accessible Preact components (Folio and Nordic themes) shared by the Leo apps.",
  "license": "MIT",
  "author": "Leonard Schwier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardSchwier/leoforma.git"
  },
  "keywords": [
    "leoforma",
    "design-tokens",
    "preact",
    "accessibility",
    "css-custom-properties",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./components.css": "./dist/components.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "preact": ">=10.25.0 <12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "preact": "^10.25.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "homepage": "https://github.com/LeonardSchwier/leoforma"
}
